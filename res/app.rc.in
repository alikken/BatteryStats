#pragma code_page(65001)
1 ICON "@RES@/app.ico"
1 24 "@RES@/app.manifest"

1 VERSIONINFO
FILEVERSION @V1@,@V2@,@V3@,0
PRODUCTVERSION @V1@,@V2@,@V3@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904b0"
    BEGIN
      VALUE "CompanyName", "alikken"
      VALUE "FileDescription", "BatteryStats by alikken"
      VALUE "FileVersion", "@VER@"
      VALUE "InternalName", "BatteryStats"
      VALUE "LegalCopyright", "© 2026 alikken"
      VALUE "OriginalFilename", "BatteryStats.exe"
      VALUE "ProductName", "BatteryStats"
      VALUE "ProductVersion", "@VER@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0419, 1200
  END
END
